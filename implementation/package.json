{
  "name": "rt-sitram-implementation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rt-sitram/web dev",
    "build": "pnpm --filter @rt-sitram/web build",
    "typecheck": "pnpm --filter @rt-sitram/shared typecheck && pnpm --filter @rt-sitram/domain typecheck && pnpm --filter @rt-sitram/integrations typecheck && pnpm --filter @rt-sitram/goldcar-worker typecheck && pnpm --filter @rt-sitram/ocr-benchmark typecheck && pnpm --filter @rt-sitram/web typecheck",
    "lint": "oxlint --deny-warnings apps packages",
    "format": "oxfmt --write apps packages scripts/repo-map.mjs package.json",
    "format:check": "oxfmt --check apps packages scripts/repo-map.mjs package.json && node scripts/repo-map.mjs --check",
    "repo-map:check": "node scripts/repo-map.mjs --check",
    "repo-map:update": "node scripts/repo-map.mjs --write",
    "pilot:check-env": "node scripts/validate-pilot-environment.mjs --pilot-env-file .env.pilot.local",
    "test": "pnpm --filter @rt-sitram/domain test && pnpm --filter @rt-sitram/integrations test && pnpm --filter @rt-sitram/goldcar-worker test && pnpm --filter @rt-sitram/ocr-benchmark test && pnpm --filter @rt-sitram/web test",
    "goldcar:probe": "pnpm --filter @rt-sitram/goldcar-worker probe",
    "goldcar:inspect-schema": "pnpm --filter @rt-sitram/goldcar-worker inspect-schema",
    "goldcar:inspect-request-manifest": "pnpm --filter @rt-sitram/goldcar-worker inspect-request-manifest",
    "goldcar:inspect-static-resource-manifest": "pnpm --filter @rt-sitram/goldcar-worker inspect-static-resource-manifest",
    "goldcar:inspect-sensors": "pnpm --filter @rt-sitram/goldcar-worker inspect-sensors",
    "goldcar:inspect-target-availability": "pnpm --filter @rt-sitram/goldcar-worker inspect-target-availability",
    "goldcar:sync": "pnpm --filter @rt-sitram/goldcar-worker sync",
    "ocr:benchmark": "pnpm --filter @rt-sitram/ocr-benchmark benchmark",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:create-test-user": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/scripts/create-local-test-user.ps1",
    "supabase:verify-spike-rls": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/scripts/verify-spike-records-rls.ps1",
    "supabase:verify-identity-company-rls": "node --env-file-if-exists=apps/web/.env.local apps/web/scripts/verify-identity-company-rls.mjs",
    "supabase:bootstrap-management": "node --env-file-if-exists=apps/web/.env.local apps/web/scripts/bootstrap-management-user.mjs",
    "supabase:rt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-rt.ps1",
    "powersync:rt": "pwsh -NoProfile -File scripts/powersync-rt.ps1"
  },
  "devDependencies": {
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "powersync": "0.10.0",
    "supabase": "2.114.0"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "packageManager": "pnpm@11.19.0"
}
