# Manifiesto local para revisar un entorno piloto aislado.
# Copie este archivo como .env.pilot.local, complete solo valores del piloto y
# ejecute `pnpm pilot:check-env`. No configura Vite ni Vercel por sí solo.
#
# Las VITE_* son públicas. Nunca agregue service_role, contraseñas, PAT,
# tokens administrativos, secretos JWT ni APP_ORIGIN a este archivo.
VITE_APP_ENV=pilot
PILOT_TARGET_NAME=rt-sitram-pilot
PILOT_CONFIRMATION=I_CONFIRM_ISOLATED_PILOT
PILOT_SUPABASE_PROJECT_REF=replace_with_pilot_project_ref
VITE_SUPABASE_URL=https://replace_with_pilot_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_pilot_key
VITE_POWERSYNC_URL=https://replace_with_pilot_instance.powersync.com
PILOT_APP_ORIGIN=https://replace_with_pilot_origin.example.com
