# Live reads remain disabled until this explicit kill switch is enabled locally.
GOLDCAR_PORTAL_ALLOW_LIVE_READ=false

# This separate switch permits exactly one non-persistent inspection of one
# approved asset's visible detail. Keep it false outside that one-off window.
GOLDCAR_SENSOR_INSPECTION_ALLOW_READ=false
# Separate from sensor detail: this one-shot diagnostic only classifies whether
# the approved visible target becomes unique, absent, hidden, or ambiguous in
# the objects window. It never opens the detail document or reads a value.
GOLDCAR_TARGET_AVAILABILITY_INSPECTION_ALLOW_READ=false
# A second, narrowly scoped gate permits up to five browser-generated GET
# XHR/fetch requests from the authenticated `/objects` document so its visible
# list can render for either approved diagnostic. It accepts no route or
# request configuration.
GOLDCAR_OBJECTS_BOOTSTRAP_ALLOW_DYNAMIC_READ=false
# Only the `PORTAL-NAME:<visible-unit-name>` canonical selector is accepted
# for one detail target. Never print it in shell output, logs, or diagnostics.
GOLDCAR_SENSOR_TARGET_CANONICAL_ID=

# This third, independent switch permits exactly one ephemeral read of the
# already approved CSV export. Its CLI prints only normalized column names and
# a row count; it never prints any CSV cell, asset identifier, or coordinate.
GOLDCAR_CSV_SCHEMA_INSPECTION_ALLOW_READ=false

# This fourth, independent switch allows a passive request-manifest check
# while loading /objects. Dynamic GET XHR/fetch candidates stay blocked before
# network dispatch and its CLI prints only aggregate, sanitized metadata.
GOLDCAR_REQUEST_MANIFEST_INSPECTION_ALLOW_READ=false

# This fifth, independent switch permits a passive classification of static
# resource requests that the current policy already blocks. It never relaxes
# the policy and prints only aggregate counts by fixed type/path classes.
GOLDCAR_STATIC_RESOURCE_MANIFEST_INSPECTION_ALLOW_READ=false

# A second, independent kill switch is required before a manual read can write
# normalized evidence to Supabase. Keep it false outside an approved window.
GOLDCAR_SYNC_ALLOW_PERSIST=false

# Never place these values in VITE_* variables or commit .env.local.
GOLDCAR_PORTAL_EMAIL=
GOLDCAR_PORTAL_PASSWORD=

# Server-side values only. Do not use VITE_* names and do not copy values from
# the browser bundle. Use an elevated Supabase secret (`sb_secret_*`) or legacy
# service_role key only in .env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# UUIDs only. The profile must be an active management profile of this company.
GOLDCAR_SYNC_COMPANY_ID=
GOLDCAR_SYNC_OPERATOR_PROFILE_ID=
GOLDCAR_SYNC_LEASE_SECONDS=120
GOLDCAR_SYNC_MAX_DURATION_SECONDS=240
GOLDCAR_SYNC_PERSISTENCE_MAX_ATTEMPTS=3
GOLDCAR_SYNC_PERSISTENCE_RETRY_BASE_MS=250

GOLDCAR_PORTAL_BASE_URL=https://satelital.gpsgoldcar.com
GOLDCAR_PORTAL_TIME_ZONE_OFFSET=-05:00
GOLDCAR_PORTAL_MAX_ASSETS=100
GOLDCAR_PORTAL_TIMEOUT_MS=30000
GOLDCAR_PORTAL_MAX_RESPONSE_BYTES=1000000
GOLDCAR_BROWSER_HEADLESS=true

# Use either a local Chrome/Edge channel or an explicit Chromium executable.
GOLDCAR_BROWSER_CHANNEL=chrome
# GOLDCAR_BROWSER_EXECUTABLE_PATH=
